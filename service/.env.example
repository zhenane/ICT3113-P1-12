# Single-model mode: set OLLAMA_MODEL and leave CASCADE_ENABLED=false
OLLAMA_MODEL=llama3.2:3b

# Cascade mode: set CASCADE_ENABLED=true
# Small model = OLLAMA_MODEL, large model = OLLAMA_MODEL_LARGE
OLLAMA_MODEL_LARGE=qwen3:1.7b
CASCADE_ENABLED=false

# Word-count threshold (the setting knob):
#   S1: CASCADE_SHORT_WORDS=0  (category-only, accept safe categories)
#   S2: CASCADE_SHORT_WORDS=80 (also accept tickets <= 80 words)
CASCADE_SHORT_WORDS=0
